{
  "name": "agentscope",
  "displayName": "AgentScope",
  "description": "Manage workspace visibility and independent Codex permission profiles for saved project scopes.",
  "version": "0.8.1",
  "icon": "media/icon.png",
  "publisher": "SuperEntity",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "workspace",
    "submodule",
    "agents",
    "codex",
    "permissions"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "View scopes in Restricted Mode; configuration changes require a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onView:agentscope.projects",
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vscode:prepublish": "npm run compile",
    "prepackage": "node -e \"require('node:fs').mkdirSync('artifacts', { recursive: true })\"",
    "package": "vsce package --allow-missing-repository --out artifacts/"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentscope",
          "title": "AgentScope",
          "icon": "media/scope.svg"
        }
      ]
    },
    "views": {
      "agentscope": [
        {
          "id": "agentscope.projects",
          "name": "Projects and scopes",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "agentscope.refresh",
        "title": "Refresh",
        "category": "AgentScope",
        "icon": "$(refresh)"
      },
      {
        "command": "agentscope.addFolder",
        "title": "Add folder",
        "category": "AgentScope",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentscope.selectWorkspace",
        "title": "Select workspace folder",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.sharedPaths",
        "title": "Manage workspace resources",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.removeProject",
        "title": "Remove project entry",
        "category": "AgentScope",
        "icon": "$(remove)"
      },
      {
        "command": "agentscope.configure",
        "title": "Configure project scope",
        "category": "AgentScope",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentscope.toggleVisibility",
        "title": "Toggle folder visibility",
        "category": "AgentScope",
        "icon": "$(eye)"
      },
      {
        "command": "agentscope.toggleAccess",
        "title": "Enable or disable agent access",
        "category": "AgentScope",
        "icon": "$(shield)"
      },
      {
        "command": "agentscope.apply",
        "title": "Apply workspace scopes",
        "category": "AgentScope",
        "icon": "$(check)"
      },
      {
        "command": "agentscope.preview",
        "title": "Preview changes",
        "category": "AgentScope",
        "icon": "$(diff)"
      },
      {
        "command": "agentscope.restore",
        "title": "Restore last applied configuration",
        "category": "AgentScope",
        "icon": "$(history)"
      },
      {
        "command": "agentscope.recover",
        "title": "Recover saved configuration",
        "category": "AgentScope",
        "icon": "$(history)"
      },
      {
        "command": "agentscope.reconfigure",
        "title": "Reconfigure access",
        "category": "AgentScope",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agentscope.openConfiguration",
        "title": "Open AgentScope configuration",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.openCodex",
        "title": "Open Codex workspace configuration",
        "category": "AgentScope"
      },
      {
        "command": "agentscope.newChat",
        "title": "New Codex chat",
        "category": "AgentScope",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentscope.toggleNewChatPresetPrompt",
        "title": "Prompt for a preset with Ctrl+N",
        "category": "AgentScope",
        "toggled": "config.agentscope.promptPresetForNewChat"
      },
      {
        "command": "agentscope.savePreset",
        "title": "Save preset",
        "category": "AgentScope",
        "icon": "$(save)"
      },
      {
        "command": "agentscope.updatePreset",
        "title": "Update preset",
        "category": "AgentScope",
        "icon": "$(save)"
      },
      {
        "command": "agentscope.activatePreset",
        "title": "Activate preset",
        "category": "AgentScope",
        "icon": "$(list-selection)"
      },
      {
        "command": "agentscope.deletePreset",
        "title": "Delete preset",
        "category": "AgentScope",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentscope.selectWorkspace",
          "when": "view == agentscope.projects",
          "group": "configuration@1"
        },
        {
          "command": "agentscope.sharedPaths",
          "when": "view == agentscope.projects",
          "group": "configuration@2"
        },
        {
          "command": "agentscope.restore",
          "when": "view == agentscope.projects",
          "group": "configuration@3"
        },
        {
          "command": "agentscope.recover",
          "when": "view == agentscope.projects",
          "group": "configuration@4"
        },
        {
          "command": "agentscope.reconfigure",
          "when": "view == agentscope.projects",
          "group": "configuration@5"
        },
        {
          "command": "agentscope.openConfiguration",
          "when": "view == agentscope.projects",
          "group": "configuration@6"
        },
        {
          "command": "agentscope.toggleNewChatPresetPrompt",
          "when": "view == agentscope.projects",
          "group": "configuration@7"
        },
        {
          "command": "agentscope.openCodex",
          "when": "view == agentscope.projects",
          "group": "configuration@8"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentscope.newChat",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "chatgpt.supportsNewChatKeyShortcut && config.agentscope.promptPresetForNewChat"
      }
    ],
    "configuration": {
      "title": "AgentScope",
      "properties": {
        "agentscope.promptPresetForNewChat": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Route Codex's Ctrl+N shortcut through the preset picker. AgentScope: New Codex chat always shows the picker. Select the matching permission profile in Codex before sending; its internal + button cannot be intercepted by external extensions."
        },
        "agentscope.codexWindowsSandbox": {
          "type": "string",
          "enum": ["auto", "mxc", "legacy"],
          "default": "auto",
          "scope": "resource",
          "description": "Native Windows backend. Auto verifies MXC with Codex on eligible Windows 11 systems, pins it when supported, and otherwise uses the legacy elevated backend. MXC fails if verification fails. WSL uses its Linux sandbox."
        },
        "agentscope.generateCodexProfile": {
          "type": "boolean",
          "default": true,
          "description": "Generate a Codex permission profile when applying changes. Requires a compatible Codex client."
        },
        "agentscope.profileName": {
          "type": "string",
          "default": "agentscope",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Name of the generated Codex permission profile."
        },
        "agentscope.codexRuntime": {
          "type": "string",
          "enum": ["auto", "native", "wsl"],
          "default": "auto",
          "scope": "resource",
          "description": "Path format for generated Codex permissions. Auto follows Codex's Run in Windows Subsystem for Linux setting; native uses the extension host's paths; wsl maps Windows drives to /mnt/<drive>."
        },
        "agentscope.codexWorkspaceRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional absolute path of the selected workspace as seen by Codex, for example /mnt/d/MyApps. Use for custom WSL mount points or other runtime path mappings. Apply to regenerate the profile."
        },
        "agentscope.codexFilesystemMode": {
          "type": "string",
          "enum": ["auto", "strict", "windows-compatible"],
          "enumDescriptions": [
            "Use strict isolation with verified MXC on native Windows, otherwise Windows compatibility. Linux, macOS and WSL use strict isolation.",
            "Restrict reads and writes to selected paths. Native Windows requires a compatible sandbox such as MXC; legacy Windows sandboxes may refuse to start.",
            "Allow broad reads on native Windows while restricting writes to selected paths. Linux, macOS and WSL keep strict read isolation."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Filesystem compatibility for the selected Codex runtime. Auto uses verified MXC when available; legacy native Windows permits reading outside selected paths. Preview and Apply to regenerate profiles."
        },
        "agentscope.excludeFromSearch": {
          "type": "boolean",
          "default": true,
          "description": "Apply folder visibility choices to VS Code search exclusions as well."
        },
        "agentscope.allowCommandNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Allow command network access in the generated Codex profile. Enabled access has no domain filtering by default."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Super-Entity/AgentScope.git"
  },
  "homepage": "https://github.com/Super-Entity/AgentScope#readme",
  "bugs": {
    "url": "https://github.com/Super-Entity/AgentScope/issues"
  }
}
